# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI providers — read only by Supabase Edge Functions, never by the client.
# Set these with `npx supabase secrets set` for deployed functions, or in
# supabase/functions/.env for local development.
#
# Currently active: Groq (see supabase/functions/ai-orchestrator/providers/
# groq.ts) — chosen for cost pre-revenue. Anthropic/Gemini keys are listed
# for when it's time to switch back; they aren't read unless the
# orchestrator's provider import is switched back to providers/claude.ts.
GROQ_API_KEY=
# Optional overrides — check https://console.groq.com/docs/models first,
# the catalog changes over time. Defaults live in providers/groq.ts.
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Not currently used (kept for when the provider is switched back):
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Which provider the AI orchestrator uses by default
DEFAULT_AI_PROVIDER=groq
